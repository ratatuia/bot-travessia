# Bot Travessia v2 - Environment Variables Template
#
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com suas credenciais reais
# 3. NUNCA commite o arquivo .env no Git!

# ===================================
# OpenAI Configuration
# ===================================
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# ===================================
# Twilio Configuration (WhatsApp)
# ===================================
# Obtenha em: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here

# ===================================
# Telegram Configuration
# ===================================
# Obtenha com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ===================================
# Security (OBRIGATÓRIO - Para Produção)
# ===================================
# Protege endpoints /reset-db e /debug-state
# Gere uma nova chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# EXEMPLO (NÃO USE ESTE): jFjG7aYZX3S3k_KSlYfILbekm_2x_2xUms0mUjMUVKo
ADMIN_API_KEY=your_secure_random_key_here

# ===================================
# Database (Opcional)
# ===================================
# Deixe vazio para usar SQLite (padrão)
# Para PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ===================================
# Application Settings
# ===================================
FLASK_ENV=production
PORT=8080
